# ── Folder paths ──────────────────────────────────────────────────────────────
# Defaults to sibling folders of Code/ — override only if your layout differs

INPUT_FOLDER         = C:\Users\YourName\Downloads\PROJECTS\Watermark_Automation\Input Images
OUTPUT_FOLDER        = C:\Users\YourName\Downloads\PROJECTS\Watermark_Automation\Output Images
ALL_RAW_FOLDER       = C:\Users\YourName\Downloads\PROJECTS\Watermark_Automation\All Raw
ALL_PROCESSED_FOLDER = C:\Users\YourName\Downloads\PROJECTS\Watermark_Automation\All Processed
FAILED_FOLDER        = C:\Users\YourName\Downloads\PROJECTS\Watermark_Automation\Failed Images
REPORTS_FOLDER       = C:\Users\YourName\Downloads\PROJECTS\Watermark_Automation\Reports

# ── Watermark ─────────────────────────────────────────────────────────────────

WATERMARK_TEXT     = Login Realty

# Position options: center | lower-center | bottom-right | bottom-left | top-right | top-left
WATERMARK_POSITION = center

# 0.0 (invisible) to 1.0 (fully opaque)
WATERMARK_OPACITY  = 0.90

# Fixed watermark width in pixels — same on every image regardless of image size
WATERMARK_WIDTH_PX = 100

# Margin from edge as % of shortest image dimension (used by non-center positions)
MARGIN_PERCENT     = 3

# ── Output ────────────────────────────────────────────────────────────────────

# JPEG save quality (1–95)
OUTPUT_QUALITY      = 92

# Seconds between scans in --watch mode
WATCH_INTERVAL_SECS = 10
