# ============================================================
# Login Realty — Watermark Automation Config
# All paths can be absolute or left blank to use smart defaults
# relative to the Watermark_Automation/ project root.
# ============================================================

# ── Folder paths (leave blank to use defaults beside the script) ────────────
# INPUT_FOLDER=C:\Users\Login Realty\Google Drive\Watermark_Automation\Input Images
# OUTPUT_FOLDER=C:\Users\Login Realty\Google Drive\Watermark_Automation\Output Images
# ALL_RAW_FOLDER=C:\Users\Login Realty\Google Drive\Watermark_Automation\All Raw
# ALL_PROCESSED_FOLDER=C:\Users\Login Realty\Google Drive\Watermark_Automation\All Processed
# FAILED_FOLDER=C:\Users\Login Realty\Google Drive\Watermark_Automation\Failed Images

# ── Watermark appearance ────────────────────────────────────────────────────
WATERMARK_TEXT=Login Realty

WATERMARK_POSITION=lower-center             # Positions: lower-center | bottom-right | bottom-left | top-right | top-left | center

WATERMARK_OPACITY=0.40

WATERMARK_SCALE_PERCENT=20

MARGIN_PERCENT=3

# ── Output quality ──────────────────────────────────────────────────────────
OUTPUT_QUALITY=95
# JPG quality 1-95. 92 is a good balance of size and sharpness.

# ── Watcher mode ────────────────────────────────────────────────────────────
WATCH_INTERVAL_SECS=10
# How often (seconds) to re-scan Input Images in --watch mode

# ── ZIP archive (optional) ──────────────────────────────────────────────────
GENERATE_ZIP=false

# Set to true to bundle all watermarked images into a ZIP after each batch
ZIP_FILENAME=watermarked_images
